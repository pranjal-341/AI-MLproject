# Local frontend: copy to .env.local. These are public configuration values.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTH_PROXY=true
VITE_SUPABASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_PUBLISHABLE_KEY=oncobind-auth-gateway
# Optional SSR client configuration: same gateway values, not the Supabase secret.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=oncobind-auth-gateway
# On Vercel replace both localhost URLs above with your deployed HTTPS API origin.
# The gateway marker is not a credential; the backend owns the real Supabase key.
